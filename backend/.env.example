# Copy to .env and fill in. Never commit the filled-in .env.
#   cp .env.example .env

# OpenAI — used by services/openai_structurer.py for structured extraction.
# Create at https://platform.openai.com/api-keys
# NOTE: the client is constructed at import time, so the backend will not start
# at all if this is unset.
OPENAI_API_KEY=sk-...

# Supabase — used by services/supabase_client.py.
# Project URL, e.g. https://abcdefghijklm.supabase.co
# Found under Project Settings > Data API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server-side only — bypasses row level security).
# Project Settings > API keys > service_role. Never expose to the frontend.
SUPABASE_SERVICE_KEY=

# Anon/publishable key. Not currently read by the backend; present because the
# previous deployment defined it. Safe to leave blank unless you add client-side
# Supabase calls from the backend.
SUPABASE_ANON_KEY=

# Direct Postgres connection — used by backend/database.py for the two things
# PostgREST cannot do: DDL (migrations) and COPY (the bulk chunk load). Not
# needed to run the API; needed to apply a migration or rebuild the indexes.
#
# Take the SESSION POOLER string from Supabase > Connect, NOT "Direct
# connection". The direct host (db.<ref>.supabase.co) resolves to IPv6 only
# unless you buy the IPv4 add-on, so on an IPv4-only machine it fails with a
# misleading "getaddrinfo failed". The pooler host contains
# "pooler.supabase.com" and its username is "postgres.<project-ref>".
#
# PERCENT-ENCODE the password. Supabase-generated passwords commonly contain
# "@", which a URI reserves: libpq splits the userinfo at the FIRST "@", so
# half the password becomes part of the hostname — and the error is, again,
# "getaddrinfo failed". Write it as %40 (likewise %5B %5D %2F %3F %23).
# backend/database.py refuses an unencoded one and names the substitution.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
