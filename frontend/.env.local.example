# Copy to .env.local and adjust. Never commit the filled-in .env.local.
#   cp .env.local.example .env.local

# Base URL of the FastAPI backend. Optional — app/lib/api.ts falls back to
# http://localhost:8000 when unset. Set this if the backend runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NOTE: the previous deployment also defined NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Neither is read anywhere in this codebase — the
# frontend talks only to the FastAPI backend, and @supabase/supabase-js is a
# declared dependency that is never imported. They are intentionally omitted.
